{
  "name": "omegaalfa/cookie",
  "description": "Class for operations with cookies in PHP",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "omegaalfa\\Cookie\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "omegaalfa\\Cookie\\tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^12.0",
    "phpstan/phpstan": "^1.11 || ^2.0",
    "infection/infection": "dev-master"
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
