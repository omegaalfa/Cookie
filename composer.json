{
  "name": "omegaalfa/cookie",
  "description": "Secure PHP cookie management with AES-256-GCM encryption and queue support",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "cookie",
    "cookies",
    "encryption",
    "security",
    "queue",
    "php",
    "lgpd",
    "gdpr"
  ],
  "autoload": {
    "psr-4": {
      "omegaalfa\\Cookie\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "omegaalfa\\Cookie\\tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^12.0",
    "phpstan/phpstan": "^1.11 || ^2.0",
    "infection/infection": "^0.29"
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-text",
    "test:mutation": "infection --threads=4"
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
